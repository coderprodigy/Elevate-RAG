# Copy to .env and fill in. .env is git-ignored; never commit it.

# Required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # judge family (or use GEMINI_API_KEY; decided at model freeze)
HF_TOKEN=

# Waterloo vLLM server, reached through the SSH tunnel (docs/setup/05_waterloo_servers.md)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=

# Fallback hosting for open-weight models
OPENROUTER_API_KEY=

# Optional (E5 comparisons, tracing)
COHERE_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Databases (docker/README.md). Defaults match the compose files; reach them via the SSH tunnel.
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hgrag-dev-password
MEMGRAPH_URI=bolt://localhost:7688
MILVUS_URI=http://localhost:19530
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hgrag
POSTGRES_PASSWORD=hgrag-dev-password
POSTGRES_DATABASE=hgrag
