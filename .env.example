# Copy to .env and fill in only what you use. .env is git-ignored; never commit real keys.

# --- LLM / embedding APIs (any you plan to use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible local server (vLLM / Ollama / llama.cpp), e.g. http://localhost:8000/v1
OPENAI_COMPAT_BASE_URL=
# Model servers for configs/pipelines/cluster_gpu*.yaml (set automatically inside cluster jobs
# by infrastructure/cluster/serve_models.sh; set them by hand on a GPU workstation)
ELEVATE_GEN_URL=
ELEVATE_JUDGE_URL=
ELEVATE_JUDGE2_URL=
COHERE_API_KEY=
JINA_API_KEY=
HF_TOKEN=

# --- Databases (used by infrastructure/docker/docker-compose.yml and storage adapters) ---
ELEVATE_QDRANT_URL=http://localhost:16333
ELEVATE_MILVUS_URI=http://localhost:19531
ELEVATE_PG_DSN=postgresql://elevate:change-me@localhost:15432/elevate_rag
ELEVATE_PG_PASSWORD=change-me
ELEVATE_NEO4J_URI=bolt://localhost:17687
ELEVATE_NEO4J_USER=neo4j
ELEVATE_NEO4J_PASSWORD=change-me-please
ELEVATE_MEMGRAPH_URI=bolt://localhost:17688

# --- Results and tracking ---
# Every completed run writes a record to $ELEVATE_RESULTS_DIR/runs/ (commit these files).
ELEVATE_RESULTS_DIR=results
# 1 = also log every run to MLflow (extra `tracking`); default store sqlite:///$ELEVATE_RUNS_DIR/mlflow.db
ELEVATE_MLFLOW=0
MLFLOW_TRACKING_URI=

# --- Storage locations (relative to the repo by default; on EC2 point them at the data volume,
#     e.g. /mnt/elevate/data). They do not affect run ids, so data can be moved and runs resume.
ELEVATE_DATA_DIR=data
ELEVATE_CACHE_DIR=data/cache
ELEVATE_INDEX_DIR=indexes
ELEVATE_RUNS_DIR=runs

# --- Database containers ---
# Host interface the DB ports bind to. Keep 127.0.0.1 on servers: the databases are then never
# reachable from outside the machine, whatever the security group says.
ELEVATE_BIND_HOST=127.0.0.1
# Resource limits applied identically to every database container (fairness rule)
ELEVATE_DB_CPUS=4
ELEVATE_DB_MEMORY=4g
# Neo4j heap + page cache must fit inside ELEVATE_DB_MEMORY
ELEVATE_NEO4J_HEAP=1G
ELEVATE_NEO4J_PAGECACHE=512M

# --- LightRAG's own storage backends (used by E4 Level B; names are LightRAG's) ---
QDRANT_URL=http://localhost:16333
NEO4J_URI=bolt://localhost:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please
MEMGRAPH_URI=bolt://localhost:17688
MILVUS_URI=http://localhost:19531
MILVUS_DB_NAME=default
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=elevate
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=elevate_rag

# --- Logging ---
# ELEVATE_JSON_LOGS=1
# ELEVATE_LIGHTRAG_LOG_LEVEL=WARNING
