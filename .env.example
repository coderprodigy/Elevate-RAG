# Elevate-RAG environment variables.
# Copy to `.env` and fill in only what you need. Nothing here is required for the
# offline Tiny_Sample exit checks: they use no-setup backends and deterministic fakes.
# Secret values are never written to logs, Run_Records or error messages.

# ---------------------------------------------------------------- Paths and run settings
ELEVATE_DATA_DIR=./data
ELEVATE_RESULTS_DIR=./results
ELEVATE_CACHE_DIR=./.cache/elevate
ELEVATE_TRACE_DIR=./logs/traces
ELEVATE_SEED=42
# Hard spending caps in USD (Budget_Tracker). 0 disables paid calls entirely.
ELEVATE_RUN_SPENDING_CAP_USD=5.00
ELEVATE_PROJECT_SPENDING_CAP_USD=200.00

# ---------------------------------------------------------------- Model providers
# OpenAI or any OpenAI-compatible endpoint.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic (Claude models).
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Google (Gemini / Gemma via API).
GOOGLE_API_KEY=your-google-api-key
# Local open-weight model servers.
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your-vllm-key
# Hugging Face (gated model downloads for embedders and rerankers).
HF_TOKEN=hf_your-huggingface-token
HF_HOME=./.cache/huggingface

# ---------------------------------------------------------------- Tracing (Langfuse)
# When unset, traces go to local JSONL files under ELEVATE_TRACE_DIR.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------- Vector databases (Phase 5)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-key
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
PGVECTOR_DSN=postgresql://elevate:change-me@localhost:5432/elevate_vectors

# ---------------------------------------------------------------- Graph databases (Phase 5)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=change-me
POSTGRES_GRAPH_DSN=postgresql://elevate:change-me@localhost:5433/elevate_graph
