# Apptainer (Singularity) image for clusters without Docker. Same dependency set as the
# Dockerfile, plus the local-models extra (PyTorch with CUDA) for GPU embedders and rerankers.
#
#   apptainer build --fakeroot $ELEVATE_ROOT/elevate-rag.sif infrastructure/cluster/elevate-rag.def
#   export ELEVATE_SIF=$ELEVATE_ROOT/elevate-rag.sif      # env.sh then runs the CLI from it
#
# Build from the repository root (the %files paths are relative to it). If --fakeroot is not
# allowed on your cluster, build on a workstation and copy the .sif, or use the uv venv instead.
Bootstrap: docker
From: python:3.12.12-slim-bookworm

%files
    pyproject.toml /app/pyproject.toml
    uv.lock /app/uv.lock
    README.md /app/README.md
    src /app/src
    configs /app/configs
    scripts /app/scripts

%post
    set -eu
    pip install --no-cache-dir uv==0.11.8
    cd /app
    export UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
           UV_PROJECT_ENVIRONMENT=/opt/venv
    uv sync --locked --no-dev --no-editable --extra databases --extra local-models
    # tiktoken vocabulary baked in so jobs run on offline compute nodes
    TIKTOKEN_CACHE_DIR=/opt/tiktoken /opt/venv/bin/python -c \
        "import tiktoken; tiktoken.get_encoding('o200k_base')"
    rm -rf /root/.cache

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    export TIKTOKEN_CACHE_DIR=${TIKTOKEN_CACHE_DIR:-/opt/tiktoken}

%runscript
    exec elevate-rag "$@"

%test
    elevate-rag --help > /dev/null

%labels
    org.opencontainers.image.title elevate-rag
    org.opencontainers.image.description Hybrid vector + graph RAG research platform (CLI)
